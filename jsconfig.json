{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@scripts/*": ["./scripts/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src", "scripts", "test", "vitest.config.mjs"]
}
