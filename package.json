{
  "name": "repository-reels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4313 --strictPort",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "render": "node scripts/render.mjs",
    "compose": "node scripts/compose.mjs",
    "verify": "node scripts/verify.mjs",
    "serve": "node scripts/serve.mjs",
    "decode": "node scripts/decode.mjs",
    "lint": "oxlint .",
    "prepare": "husky",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@hyperframes/engine": "0.8.185",
    "@hyperframes/player": "0.8.185",
    "mediabunny": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.14.0"
}
